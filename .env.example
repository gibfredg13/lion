# The Lion's Den — Environment Configuration
# Copy this to .env and fill in your values

# Database password (change before production!)
DB_PASSWORD=lionsden_secure_pw

# LLM Provider (dgxspark for DGX Spark, azure for Azure OpenAI, ollama for local Ollama)
LLM_PROVIDER=dgxspark

# Inference server base URL (OpenAI-compatible API).
# NOTE: no /v1 suffix - the provider appends /v1/chat/completions and /v1/models itself.
#   DGX Station (vLLM):    http://192.168.1.129:8000
#   DGX Spark (llama.cpp): http://192.168.1.145:42000
LLM_BASEURL=http://192.168.1.129:8000

# Model name. Set it explicitly rather than leaving it blank: a blank value makes the provider
# probe /v1/models on first use, and against a box that is switched off that probe costs five
# seconds on every call until it backs off. vLLM also rejects a request with no model field.
LLM_MODEL=nvidia/Qwen3.6-35B-A3B-NVFP4

# Collapse the levels' several system messages into one before sending.
# vLLM serving Qwen3.6 answers HTTP 400 - "System message must be at the beginning." - for the
# second system message, and every level here sends between two and five of them. Leave this on
# for vLLM. llama.cpp accepts either form.
LLM_MERGE_SYSTEM_MESSAGES=true

# Reasoning models (Qwen3, DeepSeek-R1) put their chain-of-thought in `reasoning_content` and
# return an EMPTY `content` unless thinking is disabled - which reaches players as a blank reply
# from Leo. Leave this true unless you are certain the model does not reason.
LLM_DISABLE_THINKING=true

# Hard cap on generated tokens. Levels ask Leo to be brief; long replies only slow the queue.
LLM_MAX_TOKENS=320

# Max simultaneous LLM calls. This MUST match the slot count your inference server was started
# with, e.g. llama.cpp's --parallel. A single-slot server serialises everything: four concurrent
# requests were measured returning at 7s / 14s / 21s / 28s, so with 15 players the last one waits
# nearly two minutes. Levels 6 and 7 cost two calls per turn, so they feel twice as slow again.
#
#   llama-server -m <model> --parallel 4 -c 32768   # 8192 ctx per slot, ample for this game
#
# vLLM is different: continuous batching means concurrency is nearly free, and this should be set
# well above a llama.cpp slot count. Measured on the DGX Station: a single reply in 0.27s, and 16
# concurrent replies in 0.48s wall. Leaving this at 4 there costs ~8x throughput silently.
#   DGX Station (vLLM):    32
#   DGX Spark (llama.cpp): 4, matching --parallel
LLM_MAX_CONCURRENT=32

# Event access code — share this with participants at the start of the hackathon
EVENT_ACCESS_CODE=LIONHACK2026

# Self-registration is limited to these email domains (comma-separated).
EVENT_ALLOWED_EMAIL_DOMAINS=ing.com
